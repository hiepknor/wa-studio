{
  "name": "wa-studio-workspace",
  "private": true,
  "workspaces": [
    "apps/studio",
    "services/runtime",
    "packages/*"
  ],
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.63.1"
  },
  "scripts": {
    "check": "npm run openwa:server:verify && npm run contract:check && npm run check:connector && npm run check:runtime && npm run check:studio",
    "check:connector": "npm -w @wa/openwa-connector-plugin run check",
    "check:runtime": "npm -w @wa/runtime run check",
    "check:runtime:all": "npm -w @wa/runtime run check:all",
    "check:studio": "npm -w @wa/studio run check",
    "contract:generate": "npm -w @wa/runtime run contract:generate && npm -w @wa/runtime-contract run generate",
    "contract:check": "npm run contract:generate && git diff --exit-code -- packages/runtime-contract",
    "sidecar:prepare": "node tooling/prepare-runtime-sidecar.mjs",
    "desktop:prepare": "npm run release:manifest && npm run sidecar:prepare",
    "dev": "npm run desktop:prepare && npm -w @wa/studio run tauri -- dev",
    "build:desktop": "npm run desktop:prepare && npm -w @wa/studio run tauri -- build",
    "build:desktop:internal-local": "node tooling/release/internal-local-desktop.mjs build",
    "build:desktop:signed-update": "npm run release:manifest && node tooling/release/build-updater-release.mjs",
    "clean:desktop:internal-local": "node tooling/release/internal-local-desktop.mjs clean",
    "verify:desktop:internal-local": "node tooling/release/internal-local-desktop.mjs verify",
    "release:stage-updater": "node tooling/release/updater-release.mjs stage",
    "release:verify-updater": "node tooling/release/updater-release.mjs verify",
    "release:environment:check": "node tooling/release/github-release-environment.mjs",
    "release:acceptance:create": "node tooling/release/production-acceptance.mjs create",
    "release:acceptance:attach-operational": "node tooling/release/production-acceptance.mjs attach-operational",
    "release:acceptance:attach-recovery": "node tooling/release/production-acceptance.mjs attach-recovery",
    "release:acceptance:verify": "node tooling/release/production-acceptance.mjs verify",
    "release:acceptance:verify-go": "node tooling/release/production-acceptance.mjs verify-go",
    "release:operational:capture": "node tooling/release/production-operational-snapshot.mjs capture",
    "release:operational:verify": "node tooling/release/production-operational-snapshot.mjs verify",
    "release:recovery:verify": "node tooling/release/production-recovery-evidence.mjs verify",
    "release:promotion:create": "node tooling/release/production-promotion.mjs create",
    "release:promotion:verify-target": "node tooling/release/production-promotion.mjs verify-target",
    "release:promotion:verify-source": "node tooling/release/production-promotion.mjs verify-source",
    "release:promotion:verify-delta": "node tooling/release/production-promotion.mjs verify-delta",
    "openwa:server:status": "node tooling/openwa-server-release.mjs status",
    "openwa:server:sync": "node tooling/openwa-server-release.mjs sync",
    "openwa:server:promote": "node tooling/openwa-server-release.mjs promote",
    "openwa:server:verify": "node tooling/openwa-server-release.mjs verify",
    "openwa:connector:package": "npm -w @wa/openwa-connector-plugin run package",
    "openwa:connector:verify": "node tooling/verify-connector-deployment.mjs",
    "event-inbox:candidate:verify": "node tooling/verify-event-inbox-candidate.mjs",
    "check:release": "npm run check:security && node tooling/test-openwa-server-release.mjs && node tooling/test-connector-deployment.mjs && node tooling/test-event-inbox-candidate.mjs && npm run openwa:server:verify && node tooling/release/test-github-release-environment.mjs && node tooling/release/test-build-updater-release.mjs && node tooling/release/test-internal-local-desktop.mjs && node tooling/release/test-updater-release.mjs && node tooling/release/test-deployment-release.mjs && node tooling/release/test-production-operational-snapshot.mjs && node tooling/release/test-production-acceptance.mjs && node tooling/release/test-production-promotion.mjs && npm run release:manifest:check",
    "check:security": "node tooling/security/check-supply-chain.mjs",
    "release:manifest": "node tooling/generate-release-manifest.mjs",
    "release:manifest:check": "node tooling/generate-release-manifest.mjs --check",
    "test:managed-runtime": "node tooling/run-managed-runtime-e2e.mjs",
    "test:managed-runtime:external-db": "node tooling/run-managed-runtime-e2e.mjs --external-postgres",
    "test:managed-runtime:event-inbox": "node tooling/run-managed-runtime-e2e.mjs --with-event-inbox --one-shot",
    "test:integration": "npm -w @wa/runtime run test:integration && npm -w @wa/runtime run event-inbox:e2e",
    "codegraph:sync": "codegraph sync"
  },
  "allowScripts": {
    "msgpackr-extract@3.0.4": true,
    "fsevents@2.3.2": true,
    "@scarf/scarf": false,
    "esbuild": true
  }
}
