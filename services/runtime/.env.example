NODE_ENV=development
PORT=3100
RUNTIME_HTTP_BODY_MAX_BYTES=1048576
RUNTIME_HTTP_REQUEST_TIMEOUT_MS=30000
RUNTIME_HTTP_HEADERS_TIMEOUT_MS=10000
# Optional immutable image reference used by Docker Compose. Defaults to wa-runtime:local.
# WA_RUNTIME_IMAGE=ghcr.io/example/wa-runtime:reviewed-tag

# Docker Compose service addresses. For host-side processes use localhost:5433 and localhost:6380.
WA_RUNTIME_DB_NAME=wa_runtime
WA_RUNTIME_DB_USER=wa_runtime
WA_RUNTIME_DB_PASSWORD=wa_runtime
DATABASE_URL=postgresql://wa_runtime:wa_runtime@wa-runtime-postgres:5432/wa_runtime
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_QUERY_TIMEOUT_MS=30000
DATABASE_LOCK_TIMEOUT_MS=10000
DATABASE_IDLE_TRANSACTION_TIMEOUT_MS=30000
DATABASE_MAX_LIFETIME_SECONDS=3600
REDIS_URL=redis://wa-runtime-redis:6379

RUNTIME_API_KEY=replace-with-at-least-32-random-characters
# Optional, dedicated bearer token for the private /api/v1/metrics scrape endpoint.
# Keep it different from RUNTIME_API_KEY. If unset, the endpoint returns 404.
# RUNTIME_METRICS_TOKEN=replace-with-a-separate-32-character-secret
ENABLE_RUNTIME_DOCS=true

# OpenWA is deployed separately. This development URL resolves on the shared wa-dev-network.
# Docker Compose can join another existing network with OPENWA_DOCKER_NETWORK (for example,
# openwa-network on staging). The default remains wa-dev-network.
# OPENWA_DOCKER_NETWORK=openwa-network
OPENWA_BASE_URL=http://openwa-dev-api:2785
OPENWA_API_KEY=replace-with-openwa-operator-key
# Optional override. By default Runtime uses the reviewed tag generated from release/components.json.
# OPENWA_RELEASE_TAG=replace-with-reviewed-server-tag
# Every attempt and the complete retry sequence have separate upper bounds.
OPENWA_REQUEST_TIMEOUT_MS=30000
OPENWA_REQUEST_DEADLINE_MS=120000
OPENWA_RESPONSE_MAX_BYTES=33554432
OPENWA_WEBHOOK_SECRET=replace-with-at-least-32-random-characters
OPENWA_WEBHOOK_RECONCILIATION_ENABLED=false
# Required when reconciliation is enabled. Must be the externally reachable HTTPS Runtime route.
# OPENWA_WEBHOOK_CALLBACK_URL=https://wa-runtime.example.com/api/v1/webhooks/openwa
OPENWA_WEBHOOK_RECONCILIATION_INTERVAL_MS=300000
OPENWA_ALLOWED_SESSION_IDS=replace-with-dev-session-uuid
# Optional durable Event Inbox consumer. The 40 MiB response cap covers the default
# 100-event claim batch at the default 256 KiB payload limit (including base64 overhead).
# EVENT_INBOX_BASE_URL=http://127.0.0.1:34200
# EVENT_INBOX_DEVICE_TOKEN=replace-with-at-least-32-random-characters
EVENT_INBOX_POLL_INTERVAL_MS=2000
EVENT_INBOX_BATCH_SIZE=100
EVENT_INBOX_REQUEST_TIMEOUT_MS=30000
EVENT_INBOX_RESPONSE_MAX_BYTES=41943040
GATEWAY_SYNC_GROUPS_PER_MINUTE=40
GATEWAY_SYNC_ITEM_MAX_ATTEMPTS=5
GATEWAY_GROUP_DETAILS_STALE_AFTER_HOURS=24
GATEWAY_SYNC_SNAPSHOT_MIN_BASELINE=20
GATEWAY_SYNC_SNAPSHOT_DROP_RATIO=0.25
GATEWAY_SYNC_SNAPSHOT_CONFIRMATIONS=2
GATEWAY_TARGETED_RECONCILIATION_ENABLED=false
GATEWAY_GROUP_EVENT_DEBOUNCE_MS=3000
GATEWAY_GROUP_EVENT_MAX_WAIT_MS=10000
GATEWAY_SYNC_NOTIFY_WAKEUP_ENABLED=false
GATEWAY_SYNC_POLL_INTERVAL_MS=10000
GATEWAY_SYNC_ADAPTIVE_PACING=false
CONTACT_SNAPSHOT_SYNC_ENABLED=false
CONTACT_SNAPSHOT_STAGING_ENABLED=false
CONTACT_SNAPSHOT_RETENTION_DAYS=30
CONTACT_MESSAGE_OBSERVATION_RETENTION_DAYS=30
CONTACT_EVIDENCE_DUAL_WRITE_ENABLED=false
CONTACT_RESOLUTION_SHADOW_ENABLED=false
CONTACT_RESOLUTION_MAX_RUNS_PER_TICK=2
CONTACT_PROJECTION_SHADOW_ENABLED=false
CONTACT_PROJECTION_BATCH_SIZE=500
CONTACT_PROJECTION_MAX_JOBS_PER_TICK=10
CONTACT_PROJECTION_MAX_BATCHES_PER_JOB=4
CONTACT_PROJECTION_BOOTSTRAP_BATCH_SIZE=1000
CONTACT_EVIDENCE_BACKFILL_ENABLED=false
CONTACT_EVIDENCE_BACKFILL_BATCH_SIZE=2000
CONTACT_PROJECTION_READ_ENABLED=false
CONTACT_LEGACY_MEMBER_FANOUT_ENABLED=true
CONTACT_MESSAGE_ENRICHMENT_ENABLED=false
CONTACT_PERIODIC_SYNC_ENABLED=false
CONTACT_PERIODIC_SYNC_INTERVAL_MS=86400000
CONTACT_MEMBER_IDENTITY_BACKFILL_ENABLED=false
CONTACT_MEMBER_IDENTITY_BACKFILL_BATCH_SIZE=1000
CONTACT_MEMBER_IDENTITY_BACKFILL_MAX_BATCHES=20
GATEWAY_SYNC_MIN_GROUPS_PER_MINUTE=5
GATEWAY_SYNC_RATE_RECOVERY_SUCCESSES=25

# Safety interlock. Keep false until a test session and allowlist are configured.
ALLOW_LIVE_SENDS=false
# A LIVE launch must use the signed proof from a recent passing preflight.
CAMPAIGN_LIVE_PREFLIGHT_TTL_SECONDS=120
# Campaign media V1 supports one JPEG, PNG, or WebP image per campaign.
CAMPAIGN_MEDIA_IMAGE_MAX_BYTES=8388608
# PostgreSQL quota shared by completed Campaign images and active uploads.
CAMPAIGN_MEDIA_STORAGE_MAX_BYTES=536870912
CAMPAIGN_MEDIA_UPLOAD_TTL_SECONDS=86400
CAMPAIGN_MEDIA_ORPHAN_RETENTION_HOURS=24
# Accounts for the raw image, base64 conversion, and serialized OpenWA request body.
CAMPAIGN_MEDIA_SEND_MEMORY_BUDGET_BYTES=33554432
OUTBOUND_MIN_DELAY_MS=3000
OUTBOUND_MAX_DELAY_MS=7000
MESSAGE_SAFE_RETRY_MAX_ATTEMPTS=5
# Per-process BullMQ concurrency. Per-session database leases and rate limits remain authoritative.
MESSAGE_WORKER_CONCURRENCY=1
WEBHOOK_WORKER_CONCURRENCY=10
GATEWAY_WORKER_CONCURRENCY=1
CAMPAIGN_WORKER_CONCURRENCY=2

# Terminal operational data, normalized events and raw webhook envelopes have separate lifetimes.
RUNTIME_RETENTION_DAYS=90
RUNTIME_EVENT_RETENTION_DAYS=30
RUNTIME_INBOX_RETENTION_DAYS=7
RUNTIME_ACTIVITY_RETENTION_DAYS=90
RUNTIME_RAW_WEBHOOK_RETENTION_DAYS=7
RUNTIME_COMPACT_EVENT_PAYLOAD_ENABLED=true
RUNTIME_COMPACT_PROCESSED_WEBHOOK_PAYLOAD_ENABLED=true
RUNTIME_RETENTION_INTERVAL_MS=3600000
RUNTIME_RETENTION_BATCH_SIZE=5000
RUNTIME_RETENTION_MAX_BATCHES_PER_RUN=100
# Must remain below the scheduler tick timeout (five minutes).
RUNTIME_RETENTION_TIME_BUDGET_MS=240000

# Logs are always JSON.
LOG_LEVEL=debug
