[Unit]
Description=Restore the latest WA Event Inbox backup into an isolated drill database
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
EnvironmentFile=/etc/wa-event-inbox/backup.env
ExecStart=/opt/wa-event-inbox/scripts/event-inbox-restore-drill.sh
StateDirectory=wa-event-inbox-backup
Nice=15
IOSchedulingClass=idle
TimeoutStartSec=45m
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/wa-event-inbox-backup
