wa-events.onio.cc {
	encode zstd gzip

	@webhook {
		method POST
		path /api/v1/webhooks/openwa
	}
	handle @webhook {
		request_body {
			max_size 256KB
		}
		reverse_proxy 127.0.0.1:34200
	}

	@pair {
		method POST
		path /api/v1/event-inbox/pair
	}
	handle @pair {
		request_body {
			max_size 16KB
		}
		reverse_proxy 127.0.0.1:34200
	}

	@delivery {
		method POST
		path /api/v1/event-inbox/events/claim /api/v1/event-inbox/events/ack /api/v1/event-inbox/events/nack
	}
	handle @delivery {
		request_body {
			max_size 64KB
		}
		reverse_proxy 127.0.0.1:34200 {
			transport http {
				response_header_timeout 35s
			}
		}
	}

	@health {
		method GET
		path /api/v1/health/live /api/v1/health/ready
	}
	handle @health {
		reverse_proxy 127.0.0.1:34200
	}

	handle {
		respond 404
	}
}
