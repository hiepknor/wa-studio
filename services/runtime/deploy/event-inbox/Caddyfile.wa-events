wa-events.onio.cc {
	encode zstd gzip

	@webhook {
		method POST
		path /api/v1/webhooks/openwa
	}
	handle @webhook {
		request_body {
			max_size 256KB
		}
		reverse_proxy {$WA_EVENT_INBOX_UPSTREAM:127.0.0.1:34200}
	}

	@pair {
		method POST
		path /api/v1/event-inbox/pair
	}
	handle @pair {
		request_body {
			max_size 16KB
		}
		reverse_proxy {$WA_EVENT_INBOX_UPSTREAM:127.0.0.1:34200}
	}

	@delivery {
		method POST
		path /api/v1/event-inbox/events/recovery /api/v1/event-inbox/events/claim /api/v1/event-inbox/events/ack /api/v1/event-inbox/events/nack
	}
	handle @delivery {
		request_body {
			max_size 64KB
		}
		reverse_proxy {$WA_EVENT_INBOX_UPSTREAM:127.0.0.1:34200} {
			transport http {
				response_header_timeout 35s
			}
		}
	}

	@connector_control {
		method GET POST PUT
		path /api/v1/event-inbox/connectors/*
	}
	handle @connector_control {
		request_body {
			max_size 1MB
		}
		reverse_proxy {$WA_EVENT_INBOX_CONTROL_UPSTREAM:127.0.0.1:34200}
	}

	@media_upload {
		method PUT
		path /api/v1/event-inbox/media/*
	}
	handle @media_upload {
		request_body {
			max_size 8MB
		}
		reverse_proxy {$WA_EVENT_INBOX_CONTROL_UPSTREAM:127.0.0.1:34200}
	}

	@media_download {
		method GET HEAD
		path /api/v1/media/*
	}
	handle @media_download {
		reverse_proxy {$WA_EVENT_INBOX_CONTROL_UPSTREAM:127.0.0.1:34200}
	}

	@health {
		method GET
		path /api/v1/health/live
	}
	handle @health {
		reverse_proxy {$WA_EVENT_INBOX_UPSTREAM:127.0.0.1:34200}
	}

	handle {
		respond 404
	}
}
