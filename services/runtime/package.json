{
  "name": "@wa/runtime",
  "version": "0.1.0",
  "private": true,
  "description": "Durable control plane between WA Studio and OpenWA",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean --silent && tsc -p tsconfig.build.json",
    "desktop:sidecar": "npm run build --silent && pkg --targets host --compress GZip --output dist/desktop/wa-runtime dist/src/entrypoints/runtime.js",
    "dev:api": "tsx watch src/entrypoints/api.ts",
    "dev:worker": "tsx watch src/entrypoints/worker.ts",
    "dev:scheduler": "tsx watch src/entrypoints/scheduler.ts",
    "dev:runtime": "tsx src/entrypoints/runtime.ts",
    "dev:event-inbox": "tsx watch src/entrypoints/event-inbox.ts",
    "dev:webhook-proxy": "tsx scripts/webhook-proxy.ts",
    "start:api": "node dist/src/entrypoints/api.js",
    "start:worker": "node dist/src/entrypoints/worker.js",
    "start:scheduler": "node dist/src/entrypoints/scheduler.js",
    "start:runtime": "node dist/src/entrypoints/runtime.js",
    "start:event-inbox": "node dist/src/entrypoints/event-inbox.js",
    "event-inbox:migrate": "tsx src/entrypoints/event-inbox-migrate.ts",
    "event-inbox:migrate:prod": "node dist/src/entrypoints/event-inbox-migrate.js",
    "event-inbox:e2e": "npm run build --silent && node scripts/run-event-inbox-e2e.mjs",
    "migrate": "tsx scripts/migrate.ts",
    "migrate:prod": "node dist/scripts/migrate.js",
    "contract:generate": "npm run build --silent && node dist/scripts/generate-runtime-contract.js --output ../../packages/runtime-contract/openapi.json && npm run contract:connector:generate --silent",
    "contract:connector:generate": "tsx scripts/generate-openwa-connector-contract.ts",
    "contract:check": "npm --prefix ../.. run contract:check",
    "contract:openwa:import": "tsx scripts/import-openwa-contract.ts",
    "load-test:dry-run": "tsx scripts/load-test-dry-run.ts",
    "campaign:fixture:reset": "tsx scripts/reset-campaign-staging-fixture.ts",
    "campaign:lifecycle:audit": "tsx scripts/reconcile-campaign-live-status.ts",
    "campaign:lifecycle:reconcile": "tsx scripts/reconcile-campaign-live-status.ts --apply",
    "storage:acceptance": "tsx scripts/evaluate-runtime-storage.ts",
    "test": "npm run test:unit",
    "test:unit": "vitest run test/unit",
    "test:integration": "npm run build --silent && vitest run --config vitest.integration.config.ts",
    "test:group-members": "npm run build --silent && vitest run --config vitest.group-members.config.ts",
    "architecture:check": "tsx scripts/check-architecture.ts",
    "event-inbox:deployment:check": "bash -n deploy/event-inbox/event-inbox-backup.sh deploy/event-inbox/event-inbox-restore-drill.sh",
    "event-inbox:backup:test": "node scripts/test-event-inbox-backup.mjs",
    "typecheck": "tsc --noEmit",
    "check": "npm run architecture:check && npm run event-inbox:deployment:check && npm run event-inbox:backup:test && npm run typecheck && npm test && npm run build",
    "check:all": "npm run check && npm run test:integration && npm run event-inbox:e2e"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/swagger": "^12.0.1",
    "@prometheus-io/client": "^0.16.1",
    "bullmq": "^6.3.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "ioredis": "^6.0.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@yao-pkg/pkg": "^6.22.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "js-yaml": "5.2.3"
  }
}
