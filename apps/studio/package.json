{
  "name": "@wa/studio",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "check": "npm run check:frontend && npm run check:native && npm run check:release",
    "check:frontend": "npm run contract:generate && npm run test && npm run build",
    "check:native": "cargo fmt --manifest-path src-tauri/Cargo.toml -- --check && cargo clippy --manifest-path src-tauri/Cargo.toml -- -D warnings",
    "check:release": "node scripts/test-build-updater-release.mjs",
    "contract:generate": "openapi-typescript contracts/wa-runtime/v1/openapi.json -o src/shared/api/generated/runtime.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "vitest run src/features/groups/GroupsWorkspace.test.tsx src/features/campaigns/CampaignsScreen.test.tsx -t \"E2E happy path\"",
    "test:watch": "vitest",
    "runtime:sidecar:prepare": "node scripts/prepare-runtime-sidecar.mjs",
    "managed-runtime:e2e": "node scripts/run-managed-runtime-e2e.mjs",
    "managed-runtime:e2e:external-db": "node scripts/run-managed-runtime-e2e.mjs --external-postgres",
    "managed-runtime:e2e:event-inbox": "node scripts/run-managed-runtime-e2e.mjs --with-event-inbox --one-shot",
    "tauri:dev": "npm run runtime:sidecar:prepare && tauri dev",
    "tauri:build": "npm run runtime:sidecar:prepare && tauri build",
    "tauri:build:signed-update": "node scripts/build-updater-release.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-http": "^2.5.9",
    "lucide-react": "^1.31.0",
    "openapi-fetch": "^0.17.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^30.0.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "vitest": "^4.1.10"
  }
}
