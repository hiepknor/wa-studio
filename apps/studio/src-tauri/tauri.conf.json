{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WA Studio",
  "version": "0.2.4-canary.1",
  "identifier": "dev.hiepknor.wastudio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WA Studio",
        "width": 1100,
        "height": 720,
        "minWidth": 960,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; img-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "13.5",
      "hardenedRuntime": true,
      "entitlements": "./Entitlements.plist"
    },
    "externalBin": [
      "binaries/wa-runtime"
    ],
    "resources": {
      "resources/runtime-migrations/": "runtime-migrations/",
      "../../../dist/release-manifest.json": "release-manifest.json"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
